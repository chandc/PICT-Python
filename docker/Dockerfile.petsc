# Runtime for the PETSc domain-decomposition port on the DGX Spark (GB10).
#
# WHY THIS FILE EXISTS. Gate 6 needs a scaling measurement on 8+ ranks, and the Mac cannot give
# one -- it has 16 cores carrying ~2.5 cores of unrelated desktop load, so 8 MPI ranks sit at the
# edge of capacity and 16 thrash (a measured 28 s/step in the pressure solve, which is not a
# scaling result). Spark has 20 idle cores.
#
# It follows Dockerfile.amgx's reasoning rather than installing into a home-directory conda env:
# a published speed-up number whose software stack cannot be reconstructed is not a measurement,
# and scaling numbers are exactly the kind that get quoted later. Everything that affects the
# result is pinned here.
#
# THE HOST HAS NO MPI AT ALL, which is why this is a container rather than a pip install. PETSc
# needs an MPI implementation to build against, and installing one system-wide needs root on the
# host, which we do not have.
ARG BASE=cpn-spark:latest
FROM ${BASE}

# NO MPI IS INSTALLED HERE, because the base image already has one: /opt/cpn/bin/mpicc with
# headers at /opt/cpn/include/mpi.h. Installing OpenMPI from apt alongside it was the first
# attempt and it FAILED -- PETSc's configure reported "Unable to find mpi in default locations"
# because neither MPI was in a prefix it searches, and having two only made the ambiguity worse.
# Using the image's own MPI is both simpler and the right choice: it is the stack the image was
# built and tested around.

# Pinned, for the reason Dockerfile.amgx gives: an unpinned install makes the image a moving
# target, which is the problem it exists to solve.
#
# THE COMPILER GOES IN THE ENVIRONMENT, NOT THE CONFIGURE OPTIONS. Passing --with-cc is what
# a bare PETSc configure wants, but the pip package refuses it outright:
#
#     RuntimeError: Do not use --with-cc, use the environmental variable MPICC
#
# so MPICC/MPICXX point at the base image's wrappers instead. Fortran is disabled -- petsc4py
# does not need it and it is the slowest part of a PETSc build -- and debugging is off, since
# this image exists to produce timing numbers.
# THE IMAGE HAS TWO MPIs AND THE BROKEN ONE COMES FIRST ON PATH. /opt/cpn/bin/mpicc resolves
# fine and `which mpicc` finds it, but it cannot compile: its wrapper does not supply its own
# include path, so a trivial program fails with "mpi.h: No such file or directory".
# /usr/local/mpi (Open MPI 4.1.9a1) works. Three builds failed with three different-looking
# errors before this was checked, because `which` answers "is it on PATH", not "does it work" --
# the compiler was tested by COMPILING with it, which is the only question that mattered.
ENV MPI_HOME=/usr/local/mpi \
    PATH=/usr/local/mpi/bin:$PATH \
    MPICC=/usr/local/mpi/bin/mpicc \
    MPICXX=/usr/local/mpi/bin/mpicxx \
    PETSC_CONFIGURE_OPTIONS="--with-fc=0 --with-debugging=0 COPTFLAGS=-O2 CXXOPTFLAGS=-O2"
RUN pip install --no-cache-dir sympy==1.14.0 mpi4py==4.1.2 \
    && pip install --no-cache-dir petsc==3.25.5 petsc4py==3.25.5

# OpenMPI refuses to run as root without this, and in a container root is what we are. The
# alternative -- creating an unprivileged user -- buys nothing here and complicates the bind
# mount's ownership.
ENV OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
    OMP_NUM_THREADS=1 \
    PYTHONUNBUFFERED=1
WORKDIR /w
